# -----------------------------------------------------------------------------
# CLIENT-SAFE — exposed to the browser bundle (must be prefixed NEXT_PUBLIC_).
# Safe to expose: the anon key has zero table access (RLS default-denies it,
# see supabase/migrations/0001_init.sql) and only authorizes the specific
# per-upload signed tokens minted server-side.
# -----------------------------------------------------------------------------

# Your Supabase project URL, e.g. https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase Dashboard -> Project Settings -> API -> "anon" "public" key
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The public origin Crate Link is served from. Used to build share URLs
# (https://<this>/f/<token>) and QR codes. No trailing slash.
# Local dev: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# SERVER-ONLY SECRETS — never prefixed NEXT_PUBLIC_, never sent to the
# browser, never committed. Only read from route handlers / server code.
# -----------------------------------------------------------------------------

# Supabase Dashboard -> Project Settings -> API -> "service_role" "secret" key.
# Grants full read/write to the database (bypasses RLS) and storage. Treat
# like a root password.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret that authorizes calls to /api/cron/cleanup. Vercel
# automatically sends this as `Authorization: Bearer $CRON_SECRET` on
# cron-triggered requests when the env var of this exact name is set —
# generate any long random string, e.g. `openssl rand -hex 32`.
CRON_SECRET=
